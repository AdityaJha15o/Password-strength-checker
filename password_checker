#include <iostream>
#include <string>
#include <cctype>
using namespace std;
string checkStrength(string password) {
    bool hasUpper = false;     
    bool hasLower = false;     
    bool hasDigit = false;     
    bool hasSpecial = false;  
    for (char ch : password) {
        if (isupper(ch)) {
            hasUpper = true;
        }
        else if (islower(ch)) {
            hasLower = true;
        }
        else if (isdigit(ch)) {
            hasDigit = true;
        }
        else {
           hasSpecial = true;
        }
    }
    if (password.length() >= 8 && hasUpper && hasLower && hasDigit && hasSpecial) {
        return "STRONG";
    }
    else if (password.length() >= 6) {
        return "MEDIUM";
    }
    else {
        return "WEAK";
    }
}
int generateHash(string password) {

    int hashValue = 0;
    for (char ch : password) {
        hashValue = hashValue + ch;
    }
    return hashValue;
}
int main() {
    string password;
    cout << "======" << endl;
    cout << " Password Tool " << endl;
    cout << "=====" << endl;
    cout << "Enter your password: ";
    cin >> password;
    string strength = checkStrength(password);
    int hashedPassword = generateHash(password);
    cout << "\n output" << endl;
    cout << "Password Strength : " << strength << endl;
    cout << "Hashed Password   : " << hashedPassword << endl;
    cout << "\n for security reasons, the password is converted into a secure form before storing." << endl;
    return 0;
}
